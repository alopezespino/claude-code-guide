#!/usr/bin/env bash
# Fake ssh for the slurm-watch tests: drops the options, ignores the host and
# runs the remote command locally, so the probe meets the fake Slurm commands
# in this directory. FAKE_SSH_DOWN=1 simulates an unreachable host.
[ -n "${FAKE_SSH_DOWN:-}" ] && exit 255
while [ $# -gt 0 ]; do
  case "$1" in -o) shift 2 ;; -*) shift ;; *) break ;; esac
done
shift   # host
exec bash -c "$*" </dev/null
